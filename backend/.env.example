PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL trên Supabase/Neon hoặc Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lang_giao_tac?schema=public"

# JWT Secret Keys (Bắt buộc phải sinh chuỗi ngẫu nhiên 32-byte an toàn trên Production)
JWT_ACCESS_SECRET="<your_super_secret_jwt_access_key>"
JWT_REFRESH_SECRET="<your_super_secret_jwt_refresh_key>"

# Mật khẩu khởi tạo tài khoản Admin lần đầu trên Production (Nếu chưa có tài khoản admin trong DB)
ADMIN_INITIAL_PASSWORD="<your_strong_admin_initial_password>"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Google & Facebook OAuth (Tùy chọn)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Đối soát tự động Quỹ Quê Hương qua Webhook Casso / SePay (Tùy chọn)
CASSO_WEBHOOK_SECRET=""

# Zalo ZNS (Zalo Notification Service - Tùy chọn)
ZALO_OA_ACCESS_TOKEN=""
ZALO_ZNS_TEMPLATE_ID=""
