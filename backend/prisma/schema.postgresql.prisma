generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(uuid())
  fullName        String
  email           String             @unique
  passwordHash    String
  avatarUrl       String?
  role            String             @default("member")
  hometownGroup   String?
  currentLocation String?
  bio             String?
  isVerified      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  posts           Post[]
  news            News[]
  albums          Album[]            @relation("UserAlbums")
  photos          Photo[]            @relation("UserPhotos")
  events          Event[]            @relation("UserEvents")
  comments        Comment[]
  villagerProfile VillagerDirectory?

  @@map("users")
}

model Post {
  id            String      @id @default(uuid())
  authorId      String
  title         String
  slug          String      @unique
  contentHtml   String      @db.Text
  coverImageUrl String?
  status        String      @default("pending")
  category      String
  viewCount     Int         @default(0)
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]

  @@index([category])
  @@index([status])
  @@map("posts")
}

model News {
  id          String    @id @default(uuid())
  authorId    String
  title       String
  slug        String    @unique
  contentHtml String    @db.Text
  source      String?
  isOfficial  Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([isOfficial])
  @@map("news")
}

model Album {
  id           String    @id @default(uuid())
  title        String
  description  String?   @db.Text
  coverPhotoId String?
  eventDate    DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy    User      @relation("UserAlbums", fields: [createdById], references: [id], onDelete: Cascade)
  photos       Photo[]

  @@map("albums")
}

model Photo {
  id           String      @id @default(uuid())
  albumId      String
  uploaderId   String
  imageUrl     String
  thumbnailUrl String?
  caption      String?
  takenYear    Int?
  status       String      @default("pending")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  album        Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploader     User        @relation("UserPhotos", fields: [uploaderId], references: [id], onDelete: Cascade)
  comments     Comment[]

  @@index([albumId])
  @@index([status])
  @@map("photos")
}

model Event {
  id            String    @id @default(uuid())
  title         String
  description   String    @db.Text
  eventDate     DateTime
  location      String
  coverImageUrl String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy     User      @relation("UserEvents", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([eventDate])
  @@map("events")
}

model VillagerDirectory {
  id               String   @id @default(uuid())
  userId           String?  @unique
  fullName         String
  region           String
  phonePublic      Boolean  @default(false)
  contactInfo      String?
  generationBranch String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([region])
  @@index([generationBranch])
  @@map("villager_directories")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String?
  photoId   String?
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  photo     Photo?   @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([photoId])
  @@map("comments")
}

model HistoryTimeline {
  id          String   @id @default(uuid())
  yearLabel   String
  title       String
  description String   @db.Text
  imageUrl    String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderIndex])
  @@map("history_timelines")
}
